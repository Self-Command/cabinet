# Optional Claude Code environment variables.
# Copy to deploy/claude/claude.env if you need them.
#
# Keep API keys in deploy/secrets/.cabinet.env unless you intentionally want
# Claude-only environment overrides here.

# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=sonnet
# ANTHROPIC_SMALL_FAST_MODEL=haiku
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_AUTOUPDATER=1
