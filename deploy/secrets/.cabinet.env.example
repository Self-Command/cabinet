# Copy this file to deploy/secrets/.cabinet.env and chmod 600 it.
# This file is sourced by the Docker entrypoint and also read by Cabinet.

# Required for public internet deployment.
KB_PASSWORD=change-this-long-password

# Strongly recommended: generate with `openssl rand -hex 32`.
CABINET_AUTH_SALT=change-this-64-char-random-hex

# Claude Code auth. Prefer ANTHROPIC_API_KEY for API billing on a server.
ANTHROPIC_API_KEY=

# Optional alternative for Claude subscription-based automation:
# generate locally with `claude setup-token`, then paste here.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional integration/provider keys used by Cabinet skills or future providers.
OPENAI_API_KEY=
GITHUB_TOKEN=
GEMINI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
